{
  "compilerOptions": {
    "target": "ES6",
    "module": "CommonJS",
    "types": [
      "node"
    ],
    "baseUrl": ".",
    "paths": {
      "*": [
        "*",
        "../*"
      ]
    },
    "resolveJsonModule": true,
    "esModuleInterop": true
  },
  "include": [
    "*.ts", // include all .ts files in root directory
    "toolkits/**/*.ts", // include all .ts files in toolkits directory and its subdirectories (adjust according to your file structure)
    "lido-operations.ts" // include all .ts files in toolkits directory and its subdirectories (adjust according to your file structure)
  ],
  "exclude": [
    "node_modules"
  ]
}